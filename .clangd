CompileFlags:
  Compiler: clang
  Add:
    - -xc
    - -std=c23
    - -Wall
    - -Wextra
    - -I/home/victor/Projects/scop/lib
    - -I/home/victor/Projects/scop/src
    - -I/home/victor/Projects/scop/external/glfw/include
    - -I/home/victor/Projects/scop/external
    - -D_DEFAULT_SOURCE

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: None
  ClangTidy:
    CheckOptions:
      readability-function-cognitive-complexity.Threshold: 35
      readability-function-cognitive-complexity.IgnoreMacros: true
      readability-braces-around-statements.ShortStatementLines: 1
    Add: [bugprone-*, performance-*, readability-*]
    Remove:
      - readability-implicit-bool-conversion
      - readability-magic-numbers
      - readability-identifier-length
      - bugprone-easily-swappable-parameters

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

Hover:
  ShowAKA: true

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add: [-Wno-unused-function]
